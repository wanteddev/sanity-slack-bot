# Slack App
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# 테스트 계정
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=...

# (선택) 테스트 실패 시 결과 메시지에 함께 멘션할 대상 (예: <!subteam^S123ABC>)
SLACK_FAILURE_MENTION=

# (선택, CI 전용) QA TC 스프레드시트 기록 — 셋 다 있어야 동작 (src/sheets-report.ts)
# 서비스 계정 키 JSON (원본 또는 base64). 시트를 서비스 계정 이메일에 편집자로 공유해야 함
SANITY_GSHEET_CREDENTIALS=
SANITY_SHEET_ID=
# TC양식 탭 gid (기본: 738930801)
SANITY_SHEET_TEMPLATE_GID=

# (선택) 배포 트리거 — GitHub Actions가 Slack 메시지로 새니티 실행을 요청 (server.ts)
# 둘 다 있어야 트리거가 동작. secret은 userweb 레포의 SANITY_TRIGGER_SECRET과 동일해야 함
SANITY_TRIGGER_SECRET=
# 트리거 메시지를 받을 채널 ID (봇 + DEPLOY 봇 모두 초대 필요)
SANITY_TRIGGER_CHANNEL=
